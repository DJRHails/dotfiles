#!/usr/bin/env bash
# Watch GitHub PRs and print one line per change: CI result, conflicts, reviews, unresolved
# threads, comments, merge-queue removals, merges and closes. Built to feed Claude's Monitor tool.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: pr-watch [--repo OWNER/NAME] [--author LOGIN] [--interval SECS] [--state-dir DIR]
                [--requeue] [--merge-approved] [--once] [PR ...]

  PR ...           PR numbers to watch.
  --author LOGIN   Also watch every open, non-draft PR by LOGIN (@me allowed); re-resolved each
                   pass, so new PRs join and merged ones drop out.
  --repo           Default: the current directory's GitHub repo.
  --interval       Seconds between passes (default 120).
  --state-dir      Where snapshots live (default ~/.cache/pr-watch/OWNER_NAME). The first pass
                   over a PR records a baseline and prints nothing.
  --requeue        When the merge queue drops an approved, open PR for checks_timed_out,
                   put it back (gh pr merge --auto) and print "requeued".
  --merge-approved Turn on auto-merge (gh pr merge --auto) for every open, approved,
                   non-conflicting PR you authored that does not have it yet, including PRs
                   already approved on the first pass. Other people's PRs are never merged.
  --once           One pass, then exit.
EOF
}

repo="" author="" interval=120 state_dir="" requeue=0 merge_approved=0 once=0
prs=()
while (($#)); do
  case "$1" in
  --repo) repo=$2 && shift 2 ;;
  --author) author=$2 && shift 2 ;;
  --interval) interval=$2 && shift 2 ;;
  --state-dir) state_dir=$2 && shift 2 ;;
  --requeue) requeue=1 && shift ;;
  --merge-approved) merge_approved=1 && shift ;;
  --once) once=1 && shift ;;
  -h | --help) usage && exit 0 ;;
  -*) echo "pr-watch: unknown option $1" >&2 && usage >&2 && exit 2 ;;
  *) prs+=("$1") && shift ;;
  esac
done

if [[ -z $repo ]]; then
  repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)
fi
if ((${#prs[@]} == 0)) && [[ -z $author ]]; then
  echo "pr-watch: give PR numbers and/or --author" >&2 && exit 2
fi
owner=${repo%/*} name=${repo#*/}
state_dir=${state_dir:-$HOME/.cache/pr-watch/${owner}_${name}}
mkdir -p "$state_dir"
viewer=""
if ((merge_approved)); then
  viewer=$(gh api user --jq .login)
fi

# One sorted line per observable fact; a line that appears between passes is an event.
# shellcheck disable=SC2016  # $owner/$me are GraphQL and jq variables, not shell ones
snapshot() {
  gh api graphql -F number="$1" -f owner="$owner" -f name="$name" -f query='
    query($owner: String!, $name: String!, $number: Int!) {
      repository(owner: $owner, name: $name) { pullRequest(number: $number) {
        state mergeable reviewDecision isInMergeQueue autoMergeRequest { enabledAt }
        timelineItems(last: 5, itemTypes: [REMOVED_FROM_MERGE_QUEUE_EVENT]) { nodes {
          ... on RemovedFromMergeQueueEvent { createdAt reason } } }
        commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
        reviews(last: 50) { nodes { id author { login } state } }
        reviewThreads(first: 100) { nodes { id isResolved comments(last: 1) {
          nodes { author { login } } } } }
        comments(last: 50) { nodes { id author { login } } }
        author { login } } } }' --jq '.data.repository.pullRequest | .author.login as $me | [
      "state=\(.state)",
      "decision=\(.reviewDecision // "NONE")",
      "author=\($me)",
      (if .isInMergeQueue or .autoMergeRequest != null then "automerge=on" else empty end),
      "ci=\(.commits.nodes[0].commit.statusCheckRollup.state // "none")",
      (if .mergeable == "CONFLICTING" then "CONFLICTING"
       elif .mergeable == "UNKNOWN" then "mergeable=UNKNOWN" else empty end),
      (.timelineItems.nodes[] | "removed-from-merge-queue \(.createdAt) \(.reason)"),
      (.reviews.nodes[] | select(.author.login != $me)
        | "review \(.id) \(.author.login) \(.state)"),
      (.reviewThreads.nodes[] | select(.isResolved | not)
        | "open-thread \(.id) last-by=\(.comments.nodes[0].author.login)"),
      (.comments.nodes[] | select(.author.login != $me) | "comment \(.id) \(.author.login)")
    ] | .[]' | sort
}

forget() {
  local kept=() number
  for number in ${prs[@]+"${prs[@]}"}; do
    [[ $number == "$1" ]] || kept+=("$number")
  done
  prs=(${kept[@]+"${kept[@]}"})
}

# Print a failure once per streak, so an outage is one notification rather than one per pass.
report_failure() {
  [[ -f $state_dir/$1.failing ]] || echo "$2"
  touch "$state_dir/$1.failing"
}

# The author's open PRs plus the previous listing, so a PR that merged since still gets the pass
# that prints its MERGED line. The listing persists, so this holds across a Monitor re-arm too.
authored=()
list_authored() {
  local listed previous="" number
  if ! listed=$(gh pr list --repo "$repo" --author "$author" --state open \
    --json number,isDraft --jq '.[] | select(.isDraft | not) | .number' 2>"$state_dir/stderr"); then
    report_failure author "pr-watch: listing PRs by $author failed: $(head -n1 "$state_dir/stderr")"
    return 0
  fi
  rm -f "$state_dir/author.failing"
  [[ -f $state_dir/authored ]] && previous=$(<"$state_dir/authored")
  echo "$listed" >"$state_dir/authored"
  authored=()
  for number in $listed $previous; do authored+=("$number"); done
}

maybe_requeue() {
  local number=$1 line=$2
  [[ $line == removed-from-merge-queue*checks_timed_out ]] || return 0
  ((requeue)) || return 0
  local now
  if ! now=$(snapshot "$number"); then
    echo "#$number: requeue skipped, snapshot failed; run gh pr merge $number --repo $repo --auto"
    return 0
  fi
  grep -qx 'state=OPEN' <<<"$now" && grep -qx 'decision=APPROVED' <<<"$now" || return 0
  if gh pr merge "$number" --repo "$repo" --auto >/dev/null 2>&1; then
    echo "#$number: requeued after checks_timed_out"
  else
    echo "#$number: requeue FAILED; run gh pr merge $number --repo $repo --auto"
  fi
}

maybe_merge() {
  local number=$1 current=$2
  ((merge_approved)) || return 0
  grep -qx 'state=OPEN' <<<"$current" && grep -qx 'decision=APPROVED' <<<"$current" &&
    grep -qx "author=$viewer" <<<"$current" || return 0
  ! grep -qxE 'automerge=on|CONFLICTING' <<<"$current" || return 0
  if gh pr merge "$number" --repo "$repo" --auto >/dev/null 2>"$state_dir/stderr"; then
    rm -f "$state_dir/$number.merge.failing"
    echo "#$number: approved; auto-merge enabled  https://github.com/$repo/pull/$number"
  else
    report_failure "$number.merge" \
      "#$number: approved but enabling auto-merge failed: $(head -n1 "$state_dir/stderr")"
  fi
}

pass() {
  local number current file line
  [[ -z $author ]] || list_authored
  for number in $(printf '%s\n' ${prs[@]+"${prs[@]}"} ${authored[@]+"${authored[@]}"} |
    sort -un); do
    file="$state_dir/$number"
    if ! current=$(snapshot "$number" 2>"$state_dir/stderr") || [[ -z $current ]]; then
      report_failure "$number" "#$number: snapshot failed: $(head -n1 "$state_dir/stderr")"
      continue
    fi
    rm -f "$file.failing"
    # GitHub recomputes mergeability lazily; UNKNOWN keeps the last known conflict state.
    if grep -qx 'mergeable=UNKNOWN' <<<"$current" && [[ -f $file ]] && grep -qx 'CONFLICTING' "$file"; then
      current=$(printf '%s\nCONFLICTING\n' "$current" | sort)
    fi
    if [[ -f $file ]]; then
      while IFS= read -r line; do
        case "$line" in
        ci=PENDING | ci=EXPECTED | state=OPEN | decision=* | mergeable=UNKNOWN | author=* | automerge=*) ;;
        *)
          echo "#$number: $line  https://github.com/$repo/pull/$number"
          maybe_requeue "$number" "$line"
          ;;
        esac
      done < <(comm -13 "$file" <(echo "$current"))
      grep -q '^decision=APPROVED$' <<<"$current" && ! grep -q '^decision=APPROVED$' "$file" &&
        echo "#$number: now APPROVED  https://github.com/$repo/pull/$number"
    fi
    echo "$current" >"$file"
    maybe_merge "$number" "$current"
    if grep -qxE 'state=(MERGED|CLOSED)' <<<"$current"; then
      forget "$number"
    fi
  done
}

while true; do
  pass
  ((once)) && exit 0
  sleep "$interval"
done
