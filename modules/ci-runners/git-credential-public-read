#!/usr/bin/env bash
# git credential helper for taffy's CI runners: answers GitHub's auth challenge
# with the host's public-read-only token, so a fetch that would otherwise die on
# GitHub's anonymous abuse throttle ("could not read Username for
# 'https://github.com'") retries authenticated and goes through. Installed by
# provision.sh into every runner's own $HOME gitconfig, scoped to github.com;
# the token comes from set-github-token.sh. README.md § "GitHub auth on the pool".
#
# The contract git holds it to (gitcredentials(7)): invoked as
# `<helper> get|store|erase` with a key=value description on stdin. Only `get`
# answers, and only for github.com. With no token on disk it prints nothing, so
# git proceeds exactly as it does today — this helper can degrade, never break.
set -euo pipefail

TOKEN_FILE="${ACTIONS_RUNNER_GITHUB_TOKEN_FILE:-/etc/actions-runner/github-public-read-token}"

[ "${1:-}" = get ] || exit 0

host=""
while IFS= read -r line; do
  case "$line" in
  host=*) host="${line#host=}" ;;
  esac
done

[ "$host" = github.com ] || exit 0
[ -r "$TOKEN_FILE" ] || exit 0
token="$(head -n 1 "$TOKEN_FILE" | tr -d '[:space:]')"
[ -n "$token" ] || exit 0

printf 'username=x-access-token\npassword=%s\n' "$token"
