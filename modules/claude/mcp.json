{
  "mcpServers": {
    "playwriter": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "exec \"$HOME/.files/modules/claude/bin/playwriter-mcp\""
      ],
      "env": {
        "PLAYWRITER_AUTO_ENABLE": "1"
      }
    },
    "figma-dev-mode-mcp-server": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@3.1.0"
      ],
      "env": {}
    }
  }
}
